package(default_visibility = ["//visibility:public"])

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

string_flag(
    name = "GPU_PLATFORM",
    build_setting_default = "MACA",
)

config_setting(
    name = "others",
    flag_values = {
        ":GPU_PLATFORM": "OTHERS",
    },
)

config_setting(
    name = "maca",
    flag_values = {
        ":GPU_PLATFORM": "MACA",
    },
)

cc_binary(
    name = "libevent_hook.so",
    copts = [
        "-std=c++17",
        "-fPIC",
    ],
    linkopts = [
        "-ldl",
        "-shared",
    ] + select({
        ":maca": [
            "-L/opt/maca/lib",
            "-lmcruntime",
        ],
        ":others": [
        ],
    }),
    linkshared = 1,
    deps = [
    ] + select({
        ":maca": [
            "//xpu_timer/maca:maca_hook",
            "//xpu_timer/maca:only_keep_nv.lds",
        ],
        ":others": [
        ],
    }),
)
